TOR_PROXIES=socks5h://127.0.0.1:19050,socks5h://127.0.0.1:19060
THREAD_WORKERS=4
PROCESS_WORKERS=2
TASK_CAPACITY=16
BROWSER_LIMIT=2
REQUEST_TIMEOUT=60
BROWSER_BACKEND=selenium
HEADLESS=true
# Keep Chrome's sandbox enabled on the host. The example container opts out.
CHROME_NO_SANDBOX=false
# Optional Camoufox GPU pair; both values must belong to its supported dataset.
WEBGL_VENDOR=
WEBGL_RENDERER=
